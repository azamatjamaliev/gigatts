<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:GigaTTS"
        x:Class="GigaTTS.OnboardingWindow"
        Title="Добро пожаловать"
        Width="520" Height="720"
        MinWidth="460" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16">
      <TextBlock Text="GigaПисец" FontSize="32" FontWeight="Bold"/>
      <TextBlock Opacity="0.7" TextWrapping="Wrap"
                 Text="Локальная диктовка и расшифровка звонков. Речь распознаёт GigaAM v3 на этом компьютере и никуда не отправляется."/>
      <TextBlock TextWrapping="Wrap"
                 Text="По умолчанию диктовка — удержание правого Alt. Внизу экрана на время записи мигает индикатор, затем текст вставляется в активное поле."/>
      <local:InstallView/>
      <local:PermissionView/>
      <TextBlock Opacity="0.7" TextWrapping="Wrap"
                 Text="Запись звонка включается отдельно из меню значка GigaПисец. Для голоса собеседника пишется звук, который воспроизводит компьютер. Видео экрана не сохраняется. Предупредите собеседника."/>
      <Button Content="Продолжить" HorizontalAlignment="Right" Click="OnContinue"/>
    </StackPanel>
  </ScrollViewer>
</Window>
